# Copy to backend/.env for local testing against a real Supabase DB instead
# of the SQLite default. Never commit the real .env (it's gitignored).
#
# Supabase dashboard -> Project Settings -> Database -> Connection string
# -> "Transaction" pooler (port 6543) - required for serverless/Vercel,
# also fine for local dev. Use the "Session" pooler (6543, session mode) or
# direct connection (5432) only for one-off admin tasks like migrations.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
