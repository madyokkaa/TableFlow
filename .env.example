# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only - never expose to the browser. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Supabase dashboard -> Project Settings -> Database -> Connection string
# -> "Session" pooler (port 5432) - used by `supabase db push` for
# migrations (DDL doesn't work reliably through the transaction pooler).
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
