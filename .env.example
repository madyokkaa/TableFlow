# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only - never expose to the browser. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Supabase dashboard -> Project Settings -> Database -> Connection string
# -> "Session" pooler (port 5432) - used by `supabase db push` for
# migrations (DDL doesn't work reliably through the transaction pooler).
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Integration tests only (npm test) - a staff account in the TEST project.
# Never point the test run at the restaurant's production project.
TEST_HOSTESS_EMAIL=
TEST_HOSTESS_PASSWORD=

# Optional per-IP limits for the public API, "<requests>/<seconds>".
# Defaults: reservations 10/60, availability 60/60, data erasure 3/3600.
# RATE_LIMIT_DISABLED=1 turns the limiter off (the test setup does this).
# RATE_LIMIT_RESERVATIONS=10/60
# RATE_LIMIT_AVAILABILITY=60/60
# RATE_LIMIT_PRIVACY_ERASE=3/3600

# Optional, shown on /privacy. Without them the page lists only what the code
# itself collects and keeps (no operator name, no contact line).
# NEXT_PUBLIC_OPERATOR_NAME=
# NEXT_PUBLIC_PRIVACY_CONTACT=

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/cleanup
# (daily, see vercel.json). Any long random string; without it the route
# refuses every call.
CRON_SECRET=

# Load test (npm run test:concurrency): number of simultaneous bookings,
# default 1000. Set PRODUCTION_SUPABASE_URL to the live project's URL and the
# test refuses to run if NEXT_PUBLIC_SUPABASE_URL points there.
# CONCURRENCY=1000
# PRODUCTION_SUPABASE_URL=

# Telegram booking bot (docs/telegram-bot.md). Never commit real values.
# TELEGRAM_BOT_TOKEN=            # from @BotFather
# TELEGRAM_WEBHOOK_SECRET=       # 32+ random chars: A-Z a-z 0-9 _ -
# GROQ_API_KEY=
# GROQ_STT_MODEL=whisper-large-v3
# GROQ_LLM_MODEL=openai/gpt-oss-20b
# AI_BOOKING_ENABLED=1           # 0 = kill switch: the bot only points to the website
# RESTAURANT_TIME_ZONE=          # IANA zone, e.g. what the restaurant uses locally
# RESTAURANT_NAME=               # optional, shown in the bot greeting
# NEXT_PUBLIC_SITE_URL=          # https://... - links from the bot, webhook address
# RATE_LIMIT_TELEGRAM_CHAT=20/600
